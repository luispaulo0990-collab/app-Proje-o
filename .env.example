# ─── Ambiente ────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# ─── Banco (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgres://unita:troque-esta-senha@localhost:5432/unita
DATABASE_POOL_MAX=10

# ─── Autenticação ────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# true = qualquer pessoa pode se cadastrar (entra como VIEWER). O 1º usuário sempre vira ADMIN.
ALLOW_PUBLIC_REGISTRATION=true

# ─── Web / CORS ──────────────────────────────────────────────────────────
# Lista separada por vírgulas. Nunca "*" em produção.
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Em produção atrás do Nginx: TRUST_PROXY=true e COOKIE_SECURE=true
TRUST_PROXY=false
COOKIE_SECURE=false
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ─── E-mail (SMTP Hostinger) — recuperação de senha ──────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Painel de Obras Unità <no-reply@unitaengenharia.com.br>"

# ─── Integrações — sistemas externos que enviam curvas próprias (X-Api-Key) ─
# Formato: nome:chave,nome2:chave2 — chave com 32+ caracteres (openssl rand -hex 32)
INTEGRATION_API_KEYS=

# ─── Microsoft Graph — curvas próprias (Consolidado Físico - Obras.xlsx) ───
# App Registration no Entra ID com permissão de APLICATIVO Sites.Read.All (ou Files.Read.All)
# e consentimento do administrador. Os 3 primeiros ficam só no servidor.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Arquivo "02 - Colaboração/05 - Planejamento e Controle/06 - API/Consolidado Físico - Obras.xlsx"
MS_GRAPH_DRIVE_ID=b!S3La9JidLE6c3ZTf28lb-loVt7u-9xdEoIsaVk0BY_mFzM2JIEI7SoDCfFHuzgqQ
MS_GRAPH_ITEM_ID=01UQIHIUQQC7IHA3D5WFHKTF6TMWDHIWVI
MS_GRAPH_SHEET_FISICO_GERAL=BD_Infos Gerais
MS_GRAPH_CUMULATIVE_COLUMN=Replanejado Atual Acumulado - Obra
# Colunas do Consolidado (Avanço acumulado e Status cliente)
MS_GRAPH_REALIZED_COLUMN=Realizado Acumulado
MS_GRAPH_CLIENT_REPLANNED_COLUMN=Replanejado Atual Acumulado - Cliente
MS_GRAPH_TARGET_COLUMN=Meta Acumulada - Atual

# ─── Seed (opcional, npm run db:seed) ────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_WORKS=false

# ─── Frontend (Vite) ─────────────────────────────────────────────────────
# Vazio = mesma origem (/api/v1), recomendado com proxy do Vite e Nginx.
VITE_API_URL=
