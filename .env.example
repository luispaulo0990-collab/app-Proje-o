# ─── Ambiente ────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# ─── Banco (PostgreSQL / Supabase) ───────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (troque [YOUR-PASSWORD]).
# DATABASE_URL: conexão usada pela aplicação.
#   Vercel (serverless): "Transaction pooler", porta 6543.
#   Servidor Node contínuo: "Session pooler", porta 5432.
# DATABASE_MIGRATION_URL: migrations, seed e cópia de dados — "Session pooler", porta 5432.
#   Vazio = usa DATABASE_URL.
# Local sem Supabase: postgres://unita:troque-esta-senha@localhost:5432/unita
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_MIGRATION_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Vercel: 3. Servidor Node contínuo: 10.
DATABASE_POOL_MAX=3
# TLS: auto (Supabase = criptografado; verificado quando há CA) | disable | require | verify-full
DATABASE_SSL=auto
# Certificado do Supabase (Database → SSL Configuration → Download certificate): conteúdo PEM,
# PEM em base64 ou caminho do arquivo .crt. Com ele, a conexão verifica o servidor (verify-full).
DATABASE_SSL_CA=

# ─── Autenticação ────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# Quem confere as senhas: local (tabela users — demonstração) | supabase (Supabase → Authentication).
# Com supabase, o cadastro pela tela fica desligado e o papel (ADMIN/EDITOR/VIEWER) fica em users.role.
AUTH_PROVIDER=local
SUPABASE_URL=
# Chave pública sb_publishable_… — nunca a sb_secret_…
SUPABASE_PUBLISHABLE_KEY=
# true = qualquer pessoa pode se cadastrar (entra como VIEWER). O 1º usuário sempre vira ADMIN.
ALLOW_PUBLIC_REGISTRATION=true

# ─── Web / CORS ──────────────────────────────────────────────────────────
# Lista separada por vírgulas. Nunca "*" em produção.
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Em produção atrás do Nginx: TRUST_PROXY=true e COOKIE_SECURE=true
TRUST_PROXY=false
COOKIE_SECURE=false
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ─── E-mail (SMTP Hostinger) — recuperação de senha ──────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Painel de Obras Unità <no-reply@unitaengenharia.com.br>"

# ─── Integrações — sistemas externos que enviam curvas próprias (X-Api-Key) ─
# Formato: nome:chave,nome2:chave2 — chave com 32+ caracteres (openssl rand -hex 32)
INTEGRATION_API_KEYS=

# ─── Microsoft Graph — curvas próprias (Consolidado Físico - Obras.xlsx) ───
# App Registration no Entra ID com permissão de APLICATIVO Sites.Read.All (ou Files.Read.All)
# e consentimento do administrador. Os 3 primeiros ficam só no servidor.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Arquivo "02 - Colaboração/05 - Planejamento e Controle/06 - API/Consolidado Físico - Obras.xlsx"
MS_GRAPH_DRIVE_ID=b!S3La9JidLE6c3ZTf28lb-loVt7u-9xdEoIsaVk0BY_mFzM2JIEI7SoDCfFHuzgqQ
MS_GRAPH_ITEM_ID=01UQIHIUQQC7IHA3D5WFHKTF6TMWDHIWVI
MS_GRAPH_SHEET_FISICO_GERAL=BD_Infos Gerais
MS_GRAPH_CUMULATIVE_COLUMN=Replanejado Atual Acumulado - Obra
# Colunas do Consolidado (Avanço acumulado e Status cliente)
MS_GRAPH_REALIZED_COLUMN=Realizado Acumulado
MS_GRAPH_CLIENT_REPLANNED_COLUMN=Replanejado Atual Acumulado - Cliente
MS_GRAPH_TARGET_COLUMN=Meta Acumulada - Atual
# Coluna "IEC Obra" do Consolidado: aba BD_Econômico, linha cujo Item = "Geral" (vazio = não ler)
MS_GRAPH_SHEET_ECONOMICO=BD_Econômico
MS_GRAPH_IEC_COLUMN=IEC Obra
MS_GRAPH_PROJECTED_RESULT_COLUMN=Resultado Projetado Obra
MS_GRAPH_ECONOMICO_TOTAL_ITEM=Geral

# ─── Seed (opcional, npm run db:seed) ────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_WORKS=false

# ─── Frontend (Vite) ─────────────────────────────────────────────────────
# Vazio = mesma origem (/api/v1), recomendado com proxy do Vite e Nginx.
VITE_API_URL=
