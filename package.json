{
  "name": "unita-projecoes",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema de proje\u00e7\u00e3o f\u00edsico-financeira de obras \u2014 Unit\u00e0 Engenharia",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@unita/api",
    "dev:web": "npm run dev --workspace=@unita/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=@unita/api",
    "db:migrate": "npm run db:migrate --workspace=@unita/api",
    "db:seed": "npm run db:seed --workspace=@unita/api",
    "demo": "npm run build --workspace=@unita/web && npm run demo --workspace=@unita/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
